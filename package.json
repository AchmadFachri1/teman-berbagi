{
      "name": "teman-berbagi-api-mongoose",
      "version": "1.0.0",
      "description": "Backend and Frontend for Teman Berbagi",
      "main": "server/server.js",
      "scripts": {
            "start": "node server/server.js",
            "dev": "nodemon server/server.js",
            "test": "cross-env NODE_ENV=test JWT_SECRET=testsecretkey12345 jest --runInBand --detectOpenHandles --forceExit --config jest.config.js",
            "test:coverage": "cross-env NODE_ENV=test JWT_SECRET=testsecretkey12345 jest --coverage --runInBand --forceExit --config jest.config.js",
            "test:watch": "cross-env NODE_ENV=test JWT_SECRET=testsecretkey12345 jest --watch --config jest.config.js",
            "test:verbose": "cross-env NODE_ENV=test JWT_SECRET=testsecretkey12345 jest --verbose --runInBand --config jest.config.js"
      },
      "dependencies": {
            "bcryptjs": "^3.0.3",
            "body-parser": "^1.20.5",
            "cors": "^2.8.6",
            "dotenv": "^17.4.2",
            "express": "^4.22.1",
            "express-rate-limit": "^8.5.2",
            "express-validator": "^7.3.2",
            "helmet": "^8.1.0",
            "jsonwebtoken": "^9.0.3",
            "mongoose": "^9.6.2",
            "simple-update-notifier": "^2.0.0"
      },
      "devDependencies": {
            "cross-env": "^7.0.3",
            "jest": "^29.7.0",
            "mongodb-memory-server": "^9.1.6",
            "nodemon": "^3.1.14",
            "supertest": "^6.3.4"
      }
}